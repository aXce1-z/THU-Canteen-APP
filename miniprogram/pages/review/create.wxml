<view class="container">
  <!-- 评价对象 -->
  <view class="card" style="margin-bottom: 16px">
    <text class="text-bold">{{windowName}}</text>
    <text wx:if="{{dishName}}" class="text-muted"> · {{dishName}}</text>
  </view>

  <!-- 评分 -->
  <view class="card" style="margin-bottom: 16px">
    <text class="text-bold" style="margin-bottom: 12px; display: block">评分</text>
    <view class="stars-large">
      <text
        wx:for="{{[1,2,3,4,5]}}"
        wx:key="*this"
        class="star-big {{index < rating ? 'active' : ''}}"
        bindtap="onRate"
        data-index="{{index + 1}}"
      >★</text>
    </view>
    <text class="text-sm text-muted" style="margin-top: 4px; display: block">
      {{rating ? rating + '分 - ' + (rating >= 4 ? '很棒！' : rating >= 3 ? '还行' : '一般') : '点击星星评分'}}
    </text>
  </view>

  <!-- 标签 -->
  <view class="card" style="margin-bottom: 16px">
    <text class="text-bold" style="margin-bottom: 12px; display: block">标签（最多5个）</text>
    <view class="flex-wrap">
      <text
        wx:for="{{allTags}}"
        wx:key="*this"
        class="tag {{selectedTags.indexOf(item) > -1 ? 'tag-primary' : 'tag-default'}}"
        style="padding: 6px 12px; font-size: 13px; margin: 4px"
        bindtap="onToggleTag"
        data-tag="{{item}}"
      >{{item}}</text>
    </view>
  </view>

  <!-- 文字评价 -->
  <view class="card" style="margin-bottom: 16px">
    <text class="text-bold" style="margin-bottom: 12px; display: block">文字评价</text>
    <textarea
      placeholder="说说你的体验吧..."
      value="{{content}}"
      bindinput="onInput"
      maxlength="500"
      style="width: 100%; min-height: 100px; font-size: 14px"
    />
    <text class="text-xs text-muted" style="text-align: right; display: block">{{content.length}}/500</text>
  </view>

  <!-- 图片 -->
  <view class="card" style="margin-bottom: 16px">
    <text class="text-bold" style="margin-bottom: 12px; display: block">图片（选填）</text>
    <view class="flex-wrap" style="gap: 8px">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        style="position: relative; width: 80px; height: 80px"
      >
        <image src="{{item}}" mode="aspectFill" style="width: 80px; height: 80px; border-radius: 6px" />
        <text
          class="img-remove"
          bindtap="onRemoveImage"
          data-index="{{index}}"
        >✕</text>
      </view>
      <view
        wx:if="{{images.length < 9}}"
        class="img-add"
        bindtap="onChooseImage"
      >
        <text style="font-size: 28px; color: #ccc">+</text>
        <text class="text-xs text-muted">{{images.length}}/9</text>
      </view>
    </view>
  </view>

  <!-- 提交 -->
  <button type="primary" bindtap="onSubmit" loading="{{submitting}}" style="background: var(--primary)">
    提交评价
  </button>
</view>
