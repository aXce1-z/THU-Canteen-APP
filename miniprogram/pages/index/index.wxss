.quick-filters { display: flex; gap: 8px; margin-bottom: 14px; }
.filter-chip {
  padding: 6px 14px; border-radius: 16px; font-size: 12px;
  background: #fff; border: 1px solid #e4e7ed;
}
.filter-chip.active { background: #6B2F8B; color: #fff; border-color: #6B2F8B; }

.section { margin-bottom: 20px; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.section-title { font-size: 17px; font-weight: 700; }

.canteen-card { margin-bottom: 8px; }
.canteen-row { display: flex; gap: 12px; align-items: center; }
.canteen-icon {
  width: 48px; height: 48px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.canteen-color0 { background: #f3e8ff; } .canteen-color1 { background: #e8f5e9; }
.canteen-color2 { background: #fff3e0; } .canteen-color3 { background: #e3f2fd; }
.canteen-color4 { background: #fce4ec; } .canteen-color5 { background: #e0f2f1; }
.canteen-color6 { background: #fff8e1; } .canteen-color7 { background: #f3e5f5; }

.hot-scroll { white-space: nowrap; padding-bottom: 4px; }
.hot-item {
  display: inline-block; width: 130px; background: #fff;
  border-radius: 10px; padding: 10px; margin-right: 10px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06); white-space: normal;
}
.hot-img {
  width: 100%; height: 72px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 8px;
}
.hot-img-text { font-size: 28px; font-weight: 700; color: #fff; opacity: 0.7; }
.dish-color0 { background: linear-gradient(135deg, #6B2F8B, #9B59B6); }
.dish-color1 { background: linear-gradient(135deg, #E67E22, #F39C12); }
.dish-color2 { background: linear-gradient(135deg, #27AE60, #2ECC71); }
.dish-color3 { background: linear-gradient(135deg, #2980B9, #3498DB); }
.dish-color4 { background: linear-gradient(135deg, #C0392B, #E74C3C); }
.dish-color5 { background: linear-gradient(135deg, #16A085, #1ABC9C); }

.hot-name { font-size: 14px; font-weight: 600; margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.card-hover { opacity: 0.85; transform: scale(0.98); transition: all 0.15s; }
