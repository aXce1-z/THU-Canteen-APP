.info-card { margin-bottom: 12px; }

.fav-btn { padding: 8px; transition: transform 0.3s; }
.fav-btn.fav-active { animation: heartBeat 0.4s ease; }

@keyframes heartBeat {
  0% { transform: scale(1); }
  25% { transform: scale(1.3); }
  50% { transform: scale(0.9); }
  100% { transform: scale(1); }
}

.tabs { display: flex; background: #fff; border-radius: 8px; margin-bottom: 10px; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.tab-item { flex: 1; text-align: center; padding: 12px; font-size: 14px; color: #666; border-bottom: 2px solid transparent; }
.tab-item.active { color: #6B2F8B; border-bottom-color: #6B2F8B; font-weight: 600; }

.dish-card { margin-bottom: 6px; }
.dish-thumb {
  width: 52px; height: 52px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.dish-thumb-text { font-size: 22px; font-weight: 700; color: #fff; }
.dish-color0 { background: linear-gradient(135deg, #6B2F8B, #9B59B6); }
.dish-color1 { background: linear-gradient(135deg, #E67E22, #F39C12); }
.dish-color2 { background: linear-gradient(135deg, #27AE60, #2ECC71); }
.dish-color3 { background: linear-gradient(135deg, #2980B9, #3498DB); }
.dish-color4 { background: linear-gradient(135deg, #C0392B, #E74C3C); }
.dish-color5 { background: linear-gradient(135deg, #16A085, #1ABC9C); }

.review-card { margin-bottom: 8px; }
.avatar-sm {
  width: 28px; height: 28px; border-radius: 50%;
  background: linear-gradient(135deg, #6B2F8B, #9B59B6); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 600;
}

.card-hover { opacity: 0.85; transform: scale(0.98); transition: 0.15s; }
