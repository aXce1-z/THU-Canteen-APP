.user-header {
  padding: 20px 16px;
}

.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #f5f5f5;
  font-size: 15px;
}

.menu-item:last-child {
  border-bottom: none;
}
