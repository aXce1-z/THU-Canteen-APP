.sort-bar {
  display: flex;
  gap: 16px;
  margin: 12px 0;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}

.sort-item {
  font-size: 13px;
  color: #666;
}

.sort-item.active {
  color: var(--primary);
  font-weight: 600;
}

.suggestion-item {
  padding: 12px;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
}

.history-tag {
  display: inline-block;
  padding: 6px 12px;
  margin: 4px;
  background: #f5f5f5;
  border-radius: 16px;
  font-size: 13px;
  color: #666;
}

.dish-result {
  margin-bottom: 8px;
}

.loading {
  text-align: center;
  padding: 40px;
  color: #999;
}
