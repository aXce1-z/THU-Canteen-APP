.category-filter {
  white-space: nowrap;
  padding: 4px 0;
}

.filter-tag {
  display: inline-block;
  padding: 6px 14px;
  margin-right: 8px;
  border-radius: 16px;
  font-size: 13px;
  background: #fff;
  border: 1px solid var(--border);
}

.filter-tag.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.window-card {
  margin-bottom: 10px;
}

.loading {
  text-align: center;
  padding: 60px 20px;
  color: #999;
}
